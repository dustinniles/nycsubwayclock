# NYC Subway Clock - Configuration
# Copy this file to .env and customize for your setup:
#   cp .env.example .env
#
# At minimum, you MUST change: STOP_IDS and the direction labels.

# ==============================================================================
# SUBWAY CONFIGURATION (MUST CUSTOMIZE)
# ==============================================================================

# Stop IDs for your station (comma-separated, northbound and southbound)
# Find your stop IDs in: nyct-gtfs/nyct_gtfs/gtfs_static/stops.txt
# Format: <stop_id>N,<stop_id>S (N = northbound, S = southbound)
# Examples:
#   A44N,A44S = Clinton-Washington Avs (A/C line, Brooklyn)
#   A42N,A42S = Hoyt-Schermerhorn (A/C/G lines)
#   635N,635S = 14 St-Union Sq (4/5/6/N/Q/R/W lines)
#   725N,725S = Times Sq-42 St (1/2/3 lines)
#
# No route configuration needed — all MTA feeds are queried automatically,
# so any train stopping at your station (including rerouted trains) will appear.
STOP_IDS=A44N,A44S

# Maximum minutes ahead to show arriving trains (1-120)
MAX_MINUTES_AWAY=30

# Maximum trains to display per direction (keep at 2-3 to avoid overflow)
MAX_TRAINS_PER_DIRECTION=2

# ==============================================================================
# DIRECTION LABELS (MUST CUSTOMIZE)
# ==============================================================================

# 2-letter labels shown on each display line to indicate direction
# Common labels: Ma=Manhattan, Bk=Brooklyn, Qn=Queens, Bx=Bronx, Si=Staten Island
# Use lowercase for the second letter (the font may not support all uppercase)
DIRECTION_NORTH_LABEL=Ma
DIRECTION_SOUTH_LABEL=Bk

# ==============================================================================
# TIMEZONE
# ==============================================================================

TIMEZONE=America/New_York

# ==============================================================================
# DISPLAY TIMING
# ==============================================================================

# Seconds between display refreshes
DISPLAY_REFRESH_CYCLE=5

# How long to cache MTA feed data (seconds). MTA feeds update every 15-30s.
CACHE_TTL_SECONDS=15

# Maximum age of stale cache to serve during API failures (seconds)
STALE_CACHE_MAX_SECONDS=300

# ==============================================================================
# LED MATRIX HARDWARE
# ==============================================================================

# Panel dimensions
MATRIX_ROWS=32
MATRIX_COLS=64

# Number of chained panels (total width = COLS x CHAIN_LENGTH)
MATRIX_CHAIN_LENGTH=2

# GPIO slowdown: 4 for Raspberry Pi 4, 3 for Pi 3, 2 for older models
MATRIX_GPIO_SLOWDOWN=4

# PWM settings (tune for flicker vs CPU trade-off)
MATRIX_PWM_LSB_NANOSECONDS=130
MATRIX_PWM_BITS=7

# HAT type: "adafruit-hat" or "adafruit-hat-pwm" or "regular"
MATRIX_HARDWARE_MAPPING=adafruit-hat

# Show refresh rate on the display (true/false)
MATRIX_SHOW_REFRESH_RATE=false

# Brightness (0-100). Lower values reduce power draw.
MATRIX_BRIGHTNESS=70

# Refresh rate limit (Hz). Lower values improve stability.
MATRIX_LIMIT_REFRESH_HZ=60

# Hardware pulsing (false = use hardware PWM, true = use software PWM)
MATRIX_DISABLE_HARDWARE_PULSING=false

# ==============================================================================
# SIMULATION MODE (for development without LED hardware)
# ==============================================================================

# Set to true to run without LED matrix hardware (logs display output instead)
SIMULATE_DISPLAY=false

# ==============================================================================
# FONT CONFIGURATION
# ==============================================================================

FONT_PATH=MTA.ttf
FONT_SIZE=16

# ==============================================================================
# LOGGING
# ==============================================================================

LOG_LEVEL=INFO
LOG_FILE=logs/subway_clock.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
